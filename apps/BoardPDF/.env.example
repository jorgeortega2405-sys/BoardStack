APP_NAME=BoardPDF
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# REDIS CACHE & EXPIRATION QUEUE
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# BASE DE DATOS MYSQL (REGISTRO DE OPERACIONES Y CICLO DE VIDA)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=boardpdf_user
DB_PASSWORD=boardpdf_secure_password_2026
DB_NAME=boardpdf_db

# ALMACENAMIENTO DE OBJETOS AWS_S3 (MINIO EN LOCAL / S3 EN PRODUCCION)
AWS_S3_ENDPOINT=http://127.0.0.1:9000
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=minioadmin
AWS_S3_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET_NAME=boardpdf-storage
AWS_S3_FORCE_PATH_STYLE=true

# SEGURIDAD Y SESIÓN
SESSION_SECRET=boardpdf_session_secret_key_2026_super_secure

# DROPBOX API
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# GOOGLE GEMINI AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# GOOGLE DRIVE PICKER API
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# CLOUDFLARE TURNSTILE (CAPTCHA)
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# PROTECCIÓN DE ORIGEN (CLOUDFLARE PROXY / DDOS)
ENFORCE_CLOUDFLARE_ORIGIN=false
CLOUDFLARE_ORIGIN_SECRET=
