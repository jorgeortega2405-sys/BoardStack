FROM node:20-bookworm-slim
WORKDIR /app

ENV NODE_ENV=development
ENV PORT=3002
ENV HOST=0.0.0.0
ENV CHOKIDAR_USEPOLLING=true

COPY package*.json ./
RUN npm ci

COPY tsconfig*.json ./
COPY vite.config.ts ./
COPY index.html ./
COPY dev-runner.js ./
COPY public ./public
COPY client ./client
COPY src ./src

RUN npm run build:client

RUN mkdir -p /app/logs

EXPOSE 3002

HEALTHCHECK --interval=15s --timeout=3s --retries=3 --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:3002/api/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["npm", "run", "dev:watch"]
