NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

DB_HOST=mysql
DB_PORT=3306
DB_USER=boardstack_user
DB_PASSWORD=your_database_password
DB_ROOT_PASSWORD=your_root_database_password
DB_NAME=boardstack_db
CORE_DB_NAME=boardstack_core
APP_DB_NAME=boardstack_app
APP_SLUG=app
ADMIN_PORT=3002
ADMIN_URL=http://localhost:3002

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket
AWS_S3_ACCESS_KEY_ID=your_s3_access_key
AWS_S3_SECRET_ACCESS_KEY=your_s3_secret_key
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_PUBLIC_URL=http://localhost:9000/your_s3_bucket

CLOUDFLARE_TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

SESSION_SECRET=your_session_secret_at_least_32_characters

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="BoardStack <noreply@example.com>"

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

ROOM_SERVER_HOST=room-server
ROOM_SERVER_PORT=3001
